{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":dependencyDashboard",
    ":semanticCommits",
    "customManagers:makefileVersions",
    "customManagers:githubActionsVersions"
  ],
  "automerge": true,
  "postUpdateOptions": ["gomodTidy"],
  "platformAutomerge": false,
  "lockFileMaintenance": { "enabled": true },
  "labels": ["dependencies"],
  "rebaseWhen": "behind-base-branch",
  "prConcurrentLimit": 10,
  "prHourlyLimit": 0,
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "pre-commit": { "enabled": true },
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": { "labels": ["security"] },
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "go modules (non-major)"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "web npm (non-major)"
    },
    {
      "description": "The build-base image floats on its major tag by design; downstream repos pull :1.",
      "matchDepNames": ["ghcr.io/johnnycube/cairn-build-base"],
      "pinDigests": false
    }
  ]
}
