# Copy to dev.env (gitignored) and `make dev-server` / `make dev-worker` source
# it. Matches docker-compose.dev.yml. NOT for production.

# --- Server: data plane (compose services on localhost) ---
export CAIRN_DATABASE_URL="postgres://cairn:cairn@localhost:5432/cairn?sslmode=disable"
export CAIRN_DATABASE_AUTO_MIGRATE="true"
export CAIRN_NATS_URL="nats://localhost:4222"
export CAIRN_STORAGE_ENDPOINT="http://localhost:9000"
export CAIRN_STORAGE_ACCESS_KEY_ID="cairn"
export CAIRN_STORAGE_SECRET_ACCESS_KEY="cairn-secret"
export CAIRN_STORAGE_BUCKET="cairn"

# --- Dev secrets (random throwaways; regenerate any time) ---
export CAIRN_AUTH_SESSION_SECRET="dev-only-session-secret-change-me"
export CAIRN_AUTH_MASTER_ENCRYPTION_KEY="dev-only-master-encryption-key-change-me"

# --- First admin (created on first boot; this is your dev login) ---
export CAIRN_INSTANCE_BOOTSTRAP_ADMIN_EMAIL="admin@cairn.local"
export CAIRN_INSTANCE_BOOTSTRAP_ADMIN_PASSWORD="changeme"

# --- Email → Mailpit (read at http://localhost:8025) ---
export CAIRN_EMAIL_ADAPTER="smtp"           # default "none" disables sending
export CAIRN_EMAIL_FROM_ADDRESS="cairn@localhost"
export CAIRN_EMAIL_SMTP_HOST="localhost"
export CAIRN_EMAIL_SMTP_PORT="1025"
export CAIRN_EMAIL_SMTP_STARTTLS="false"    # Mailpit has no TLS on 1025

# --- Server listen addr + the origin vite proxies API paths to. Defaults to
#     :8080; if that port is taken on your machine, set BOTH to a free port
#     (they must match). make dev-web sources this so vite picks up the origin.
export CAIRN_HTTP_ADDR="0.0.0.0:8080"
export CAIRN_API_ORIGIN="http://localhost:8080"

# --- Web (vite) dev-server port. Give Cairn its OWN port if another project
#     runs vite — a shared origin mixes module graphs in the browser. The
#     PUBLIC_BASE_URL (used for email/share-link URLs) should point at it.
export CAIRN_WEB_PORT="5173"
export CAIRN_HTTP_PUBLIC_BASE_URL="http://localhost:5173"

# --- Worker (cmd/worker-strava). Provider, version + package are fixed in the
#     binary (they define the worker schema); only the name is configurable. ---
export CAIRN_WORKER_NAME="strava-fetcher"

# Only needed to import from the real Strava API (OAuth + webhooks); leave unset
# to develop the ingest/merge pipeline via manual FIT/GPX/TCX upload instead.
# export CAIRN_STRAVA_CLIENT_ID=""
# export CAIRN_STRAVA_CLIENT_SECRET=""
# export CAIRN_STRAVA_WEBHOOK_VERIFY_TOKEN=""
